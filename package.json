{
  "name": "lecture-hall-system",
  "version": "2.0.0",
  "private": true,
  "description": "Lecture Hall Assignment, Conflict Resolution & Lunch Break Management System",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "build": "npm run client:build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
